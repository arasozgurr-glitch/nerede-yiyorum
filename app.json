{
  "expo": {
    "name": "Nerede Yiyorum",
    "slug": "nerede-yiyorum",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ozguraras.neredeyiyorum",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınınızdaki restoranları bulmak ve size konumunuza göre sonuçlar göstermek için konumunuza erişiyoruz."
      }
    },
    "android": {
      "package": "com.ozguraras.neredeyiyorum",
    "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-symbol.png",
        "backgroundColor": "#FAF6EF"
      }
    },
    "icon": "./assets/brand-symbol.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF6EF"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "apiBaseUrl": "https://nerede-yiyorum-1.onrender.com"
    }
  }
}
